diff --git a/src/ext4_super.c b/src/ext4_super.c
index 092c38b..4bf9fcb 100644
--- a/src/ext4_super.c
+++ b/src/ext4_super.c
@@ -48,6 +48,20 @@
 #include <ext4_super.h>
 #include <ext4_crc32.h>
 
+/*
+ * Metadata checksums are seeded with either the 128-bit volume UUID or, when
+ * the incompatible CSUM_SEED feature is set, with the 32-bit seed stored in
+ * the superblock.  Every checksum site must use this helper rather than
+ * hashing the UUID directly.
+ */
+uint32_t ext4_sb_get_checksum_seed(struct ext4_sblock *s)
+{
+	if (ext4_sb_feature_incom(s, EXT4_FINCOM_CSUM_SEED))
+		return to_le32(s->checksum_seed);
+
+	return ext4_crc32c(EXT4_CRC32_INIT, s->uuid, sizeof(s->uuid));
+}
+
 uint32_t ext4_block_group_cnt(struct ext4_sblock *s)
 {
 	uint64_t blocks_count = ext4_sb_get_blocks_cnt(s);
